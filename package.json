{
  "name": "drone-parade-blockly",
  "version": "1.0.0",
  "description": "A Blockly coding app for kids - guide a drone through a parade grid!",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.droneblockly.parade",
    "productName": "Drone Parade",
    "files": [
      "main.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "renderer/assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "renderer/assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "blockly": "^12.0.0"
  }
}
